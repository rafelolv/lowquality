{
  "name": "lowquality",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "A privacy-friendly browser tool that intentionally destroys image quality.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:production": "npm run build && playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.2.8",
    "@fontsource/anton": "5.2.7",
    "@fontsource/press-start-2p": "5.2.7",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
